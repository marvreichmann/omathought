#!/usr/bin/env bash
# Omathought's filesystem side. The QML overlay owns the UI and the Voxtype
# lifecycle; every read and write of a note goes through here, so the rules
# about where notes live and what a note file looks like exist in exactly one
# place — and can be exercised from a terminal without the shell running.
#
#   omathought dir                  print the notes directory
#   omathought save <text>          write a new note, print its id
#   omathought list                 print [{id, created, body}] as JSON
#   omathought body <id>            print one note's body
#   omathought update <id> <text>   replace a note's body, keeping `created`
#   omathought delete <id>          remove a note
#   omathought keys                 print the keybindings to add to Hyprland
#   omathought keys --check         exit 0 if they are wired up, 1 if not
#   omathought keys --set <slot> <chord>   bind capture or browse
#   omathought keys --clear <slot|all>     unbind one or both
#
# Text arrives as a single argv element, never on stdin and never through a
# shell string, so a dictated "rm -rf" is just words.
#
# `keys` is the only part that touches Hyprland's configuration, and only when
# asked: it rewrites a single BEGIN/END block in bindings.lua, behind a one-time
# backup, and restores the original if hyprctl reports a config error that was
# not there before. Which combinations are free differs per machine, so the key
# itself is always the user's choice — this script never picks one.

set -euo pipefail

readonly SETTINGS="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/settings/omathought.json"
readonly DEFAULT_DIR="$HOME/Documents/Thoughts"
readonly HYPR_DIR="$HOME/.config/hypr"
readonly IPC_TARGET="omathought"

die() {
  printf 'omathought: %s\n' "$1" >&2
  exit 1
}

# The notes directory is read from the settings file when present, so it can be
# repointed at a synced folder without touching this script. `~` is expanded
# because a hand-edited JSON file is the obvious place to write one.
notes_dir() {
  local dir=""
  if [[ -f $SETTINGS ]]; then
    dir=$(jq -r '.notesDir // empty' "$SETTINGS" 2>/dev/null || true)
  fi
  [[ -n $dir ]] || dir=$DEFAULT_DIR
  [[ $dir == "~"* ]] && dir="$HOME${dir:1}"
  printf '%s' "$dir"
}

ensure_dir() {
  local dir
  dir=$(notes_dir)
  mkdir -p -- "$dir" || die "cannot create notes directory: $dir"
  printf '%s' "$dir"
}

# Ids are minted from the clock, so two memos dictated inside the same second
# would collide. Rather than overwrite, walk a suffix until the name is free.
mint_id() {
  local dir=$1 base id
  base=$(date +%Y%m%d-%H%M%S)
  id=$base
  local n=2
  while [[ -e "$dir/$id.md" ]]; do
    id="$base-$n"
    n=$((n + 1))
  done
  printf '%s' "$id"
}

# Reject anything that is not a name this script itself would have minted. The
# id reaches us from the overlay and is about to be pasted into a path, so path
# separators and traversal are refused outright instead of sanitized.
validate_id() {
  local id=$1
  [[ $id =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || die "invalid note id: $id"
}

note_path() {
  validate_id "$1"
  printf '%s/%s.md' "$(notes_dir)" "$1"
}

# Write through a temp file in the destination directory and rename, so a note
# is either wholly present or wholly absent — a reader (this script's own
# `list`, or an editor watching the folder) never catches a half-written file.
write_atomic() {
  local target=$1 content=$2 tmp
  tmp=$(mktemp "${target%/*}/.omathought.XXXXXX") || die "cannot create temp file"
  # Callers pass the rendered note through `$(...)`, which eats the trailing
  # newline; put exactly one back so the file is well-formed text.
  printf '%s\n' "$content" >"$tmp"
  mv -f -- "$tmp" "$target"
}

render_note() {
  local created=$1 body=$2
  printf -- '---\ncreated: %s\n---\n\n%s\n' "$created" "$body"
}

cmd_dir() {
  ensure_dir
  printf '\n'
}

cmd_save() {
  local text=${1-}
  [[ -n ${text//[[:space:]]/} ]] || die "refusing to save an empty note"

  local dir id
  dir=$(ensure_dir)
  id=$(mint_id "$dir")
  write_atomic "$dir/$id.md" "$(render_note "$(date -Is)" "$text")"
  printf '%s\n' "$id"
}

cmd_update() {
  local id=${1-} text=${2-}
  [[ -n $id ]] || die "update needs a note id"
  local path
  path=$(note_path "$id")
  [[ -f $path ]] || die "no such note: $id"

  # An edit keeps the original creation stamp; only the body is replaced. If the
  # header was lost to an external editor, fall back to the id's own instant.
  local created
  created=$(sed -n 's/^created:[[:space:]]*//p' "$path" | head -n1)
  [[ -n $created ]] || created=$(date -Is)

  if [[ -z ${text//[[:space:]]/} ]]; then
    die "refusing to empty a note; delete it instead"
  fi
  write_atomic "$path" "$(render_note "$created" "$text")"
  printf '%s\n' "$id"
}

cmd_delete() {
  local id=${1-}
  [[ -n $id ]] || die "delete needs a note id"
  local path
  path=$(note_path "$id")
  [[ -f $path ]] || die "no such note: $id"
  rm -f -- "$path"
  printf '%s\n' "$id"
}

# Strip the frontmatter block and hand back the body alone. Only a header at the
# very top counts, so a "---" rule inside a dictated note survives.
#
# The blank line separating header from body is part of the format, not part of
# the note: without dropping it here, every edit would read it back, re-render
# it under a fresh separator, and grow the note by one blank line per save.
strip_frontmatter() {
  awk '
    NR == 1 && $0 == "---" { inHeader = 1; next }
    inHeader && $0 == "---" { inHeader = 0; justClosed = 1; next }
    inHeader { next }
    justClosed { justClosed = 0; if ($0 == "") next }
    { print }
  ' "$1"
}

read_created() {
  sed -n 's/^created:[[:space:]]*//p' "$1" | head -n1
}

cmd_body() {
  local id=${1-}
  [[ -n $id ]] || die "body needs a note id"
  local path
  path=$(note_path "$id")
  [[ -f $path ]] || die "no such note: $id"
  strip_frontmatter "$path"
}

# One JSON array of every note. jq does the encoding, so a note containing
# quotes, backslashes or newlines cannot break the document the overlay parses.
cmd_list() {
  local dir
  dir=$(ensure_dir)

  local first=1
  printf '['
  local path id created body
  # Reverse-sorted by name, which is reverse-chronological: the overlay sorts
  # again, but this keeps `omathought list | jq` useful on its own.
  while IFS= read -r path; do
    [[ -f $path ]] || continue
    id=${path##*/}
    id=${id%.md}
    [[ $id =~ ^[0-9]{8}-[0-9]{6}(-[0-9]+)?$ ]] || continue

    created=$(read_created "$path")
    body=$(strip_frontmatter "$path")

    [[ $first -eq 1 ]] || printf ','
    first=0
    jq -nc --arg id "$id" --arg created "$created" --arg body "$body" \
      '{id: $id, created: $created, body: $body}'
  done < <(find "$dir" -maxdepth 1 -type f -name '*.md' | sort -r)
  printf ']\n'
}

# ---------------------------------------------------------------- keybindings

# The bar panel drives all of this. A plugin cannot ship a Hyprland binding, so
# the keys have to be recorded from the user and written here; `--json` is what
# the panel renders, and `--check` is the terminal equivalent.

# A method is wired up if any Hyprland config file calls it on this plugin's IPC
# target. Matching the call rather than a marker comment means a hand-written
# binding on a different key counts too — the user's own choice of key is the
# point, so only the wiring is checked, never the combination.
binding_present() {
  grep -rqs -- "$IPC_TARGET $1" "$HYPR_DIR" 2>/dev/null
}

bindings_ready() {
  binding_present captureStart && binding_present captureStop \
    && { binding_present toggleBrowse || binding_present browse; }
}

readonly BINDINGS="$HYPR_DIR/bindings.lua"
readonly BLOCK_BEGIN="-- BEGIN com.github.marvreichmann.omathought"
readonly BLOCK_END="-- END com.github.marvreichmann.omathought"

# The chord as Omarchy writes it: "F10", "SUPER + SHIFT + V". Anything outside
# this shape is refused rather than escaped, because it is about to be written
# into a Lua string in the user's compositor config.
valid_chord() {
  [[ $1 =~ ^([A-Za-z0-9_]+)([[:space:]]*\+[[:space:]]*[A-Za-z0-9_]+)*$ ]]
}

# Read the chord currently bound to a slot, straight out of the live config, so
# the panel shows what Hyprland actually has rather than a cached copy.
read_slot() {
  local method
  case $1 in
    capture) method=captureStart ;;
    browse)  method=toggleBrowse ;;
    *) return 1 ;;
  esac
  [[ -f $BINDINGS ]] || return 0
  sed -n "s/^o\.bind(\"\([^\"]*\)\".*$IPC_TARGET $method\".*/\1/p" "$BINDINGS" | head -n1
}

render_block() {
  local capture=$1 browse=$2
  printf '%s\n' "$BLOCK_BEGIN"
  if [[ -n $capture ]]; then
    # Both lines, always. The release binding is what makes the key
    # hold-to-talk; written on its own, the press line records forever.
    printf 'o.bind("%s", "Capture a thought", "omarchy-shell -q %s captureStart")\n' "$capture" "$IPC_TARGET"
    printf 'o.bind("%s", "Capture a thought (release)", "omarchy-shell -q %s captureStop", { release = true })\n' "$capture" "$IPC_TARGET"
  fi
  [[ -n $browse ]] && \
    printf 'o.bind("%s", "Browse thoughts", "omarchy-shell -q %s toggleBrowse")\n' "$browse" "$IPC_TARGET"
  printf '%s\n' "$BLOCK_END"
}

# Replace the managed block, or append one, leaving every other line untouched.
write_block() {
  local capture=$1 browse=$2

  [[ -f $BINDINGS ]] || die "not found: $BINDINGS"
  [[ -L $BINDINGS ]] && die "refusing to write through a symlink: $BINDINGS"
  [[ -w $BINDINGS ]] || die "not writable: $BINDINGS"

  # One backup, taken before the first write and never overwritten: it preserves
  # the file as it was before this plugin ever touched it. Stamping a new copy
  # per write would bury that original under a pile of near-identical files.
  local backup tmp
  backup="$BINDINGS.omathought-backup"
  [[ -e $backup ]] || cp -p -- "$BINDINGS" "$backup"

  tmp=$(mktemp "$HYPR_DIR/.omathought-bindings.XXXXXX") || die "cannot create temp file"
  if grep -qF -- "$BLOCK_BEGIN" "$BINDINGS"; then
    awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" -v repl="$(render_block "$capture" "$browse")" '
      $0 == b { print repl; skip = 1; next }
      $0 == e { skip = 0; next }
      !skip   { print }
    ' "$BINDINGS" >"$tmp"
  else
    cat -- "$BINDINGS" >"$tmp"
    printf '\n' >>"$tmp"
    render_block "$capture" "$browse" >>"$tmp"
  fi

  mv -f -- "$tmp" "$BINDINGS"

  # Reload and check. Hyprland reports config errors as text; if the write
  # introduced one, put the original back rather than leaving the user with a
  # broken compositor config they did not edit.
  if command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null 2>&1 || true
    local errors
    errors=$(hyprctl configerrors 2>/dev/null | tr -d '[:space:]')
    if [[ -n $errors && $errors != "nonexistent" ]]; then
      cp -p -- "$backup" "$BINDINGS"
      hyprctl reload >/dev/null 2>&1 || true
      die "hyprland rejected the change; restored from $backup"
    fi
  fi
  printf 'ok\n'
}

cmd_keys() {
  if [[ ${1-} == --check ]]; then
    if bindings_ready; then
      echo "keybindings: wired up"
      return 0
    fi
    # Report what is missing, so a half-finished paste is obvious. The release
    # binding is the one people leave out, and without it push-to-talk records
    # forever.
    binding_present captureStart || echo "missing: capture (press)"
    binding_present captureStop  || echo "missing: capture (release) — without this, recording never stops"
    binding_present toggleBrowse || binding_present browse || echo "missing: browse"
    return 1
  fi

  # What the panel reads to render its two rows.
  if [[ ${1-} == --json ]]; then
    jq -nc --arg capture "$(read_slot capture)" --arg browse "$(read_slot browse)" \
      '{capture: $capture, browse: $browse}'
    return 0
  fi

  # `--set <slot> <chord>` and `--clear <slot>` rewrite the managed block. Both
  # keep the other slot exactly as it is, so setting one key never silently
  # drops the other.
  if [[ ${1-} == --set || ${1-} == --clear ]]; then
    local action=$1 slot=${2-} chord=${3-}

    # `all` exists so removing both keys is one write, one backup check and one
    # reload — clearing them in sequence would race the second write against the
    # first one's reload.
    if [[ $action == --clear && $slot == all ]]; then
      write_block "" ""
      return 0
    fi

    [[ $slot == capture || $slot == browse ]] || die "slot must be 'capture', 'browse' or 'all'"

    if [[ $action == --set ]]; then
      [[ -n $chord ]] || die "--set needs a key combination"
      valid_chord "$chord" || die "not a usable key combination: $chord"
    else
      chord=""
    fi

    local capture browse
    capture=$(read_slot capture)
    browse=$(read_slot browse)
    [[ $slot == capture ]] && capture=$chord || browse=$chord
    write_block "$capture" "$browse"
    return 0
  fi

  cat <<'SNIPPET'
Add these to ~/.config/hypr/bindings.lua, then run: hyprctl reload

-- BEGIN com.github.marvreichmann.omathought
o.bind("F10", "Capture a thought", "omarchy-shell -q omathought captureStart")
o.bind("F10", "Capture a thought (release)", "omarchy-shell -q omathought captureStop", { release = true })
o.bind("SUPER + SHIFT + V", "Browse thoughts", "omarchy-shell -q omathought toggleBrowse")
-- END com.github.marvreichmann.omathought

Both F10 lines are required. The second one, with `release = true`, is what
makes the key hold-to-talk instead of a toggle; without it, recording never
stops.

Pick your own keys if these are taken — check with:
  omarchy menu keybindings --print
SUPER + V is NOT free: it is Omarchy's Universal paste.
SNIPPET
}

main() {
  local cmd=${1-}
  [[ -n $cmd ]] || die "usage: omathought {dir|save|list|body|update|delete|keys}"
  shift || true

  command -v jq >/dev/null || die "jq is required but not installed"

  case $cmd in
    dir)    cmd_dir ;;
    keys)   cmd_keys "$@" ;;
    save)   cmd_save "$@" ;;
    list)   cmd_list ;;
    body)   cmd_body "$@" ;;
    update) cmd_update "$@" ;;
    delete) cmd_delete "$@" ;;
    *)      die "unknown command: $cmd" ;;
  esac
}

main "$@"
